#include <iostream>
using namespace std;

void printRow(int start, int count) {
    for (int i = 0; i < count; i++) {
        cout << start + i;
        if (i < count - 1) cout << " ";    
    }
    cout << endl;                          
}

int main() {
    int n;
    cin >> n;

    int next = 1;                          
    for (int r = 1; r <= n; r++) {
        printRow(next, r);                 
        next += r;                         
    }
    return 0;
}
